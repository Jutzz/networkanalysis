@article{cournoyerBuzzwordsEvaluatingIntegration2026,
  title = {Beyond Buzzwords: {{Evaluating}} the Integration of Accessibility Goals and Indicators in Land Use and Transportation Policy Documents},
  shorttitle = {Beyond Buzzwords},
  author = {Cournoyer, Frédéric and White, Maxwell Francis and Jasso Chávez, José Arturo and Manaugh, Kevin and Waygood, E. O. D. and Boisjoly, Geneviève},
  date = {2026-06-01},
  journaltitle = {Transport Policy},
  shortjournal = {Transport Policy},
  volume = {181},
  pages = {104082},
  issn = {0967-070X},
  doi = {10.1016/j.tranpol.2026.104082},
  url = {https://www.sciencedirect.com/science/article/pii/S0967070X26000922},
  urldate = {2026-06-25},
  abstract = {Accessibility, defined as the ease of reaching destinations, is often framed as a paradigm shift in land use and transport planning. However, while widely known in research as a cornerstone of sustainable urban and transport systems, this concept has yet to be realized in planning practice. Many studies have assessed the integration of accessibility in policy documents, to evaluate the current state of practice and identify barriers to implementation. Yet, no study that looked at the integration of accessibility in policy documents has assessed accessibility across documents published by different organization types and government levels. This study addresses this gap by examining how different documents define accessibility, whether they distinguish it from mobility, and the degree to which accessibility objectives are supported by indicators. We assessed 40 Canadian documents from land use and transport planning authorities, municipalities, and transit agencies using a 20 binary questions structured content analysis framework complemented by a qualitative content analysis. We find that municipal documents score higher than documents produced by transit agencies, especially in recent years. Further, the highest accessibility score (90\%) is obtained by a municipal integrated land use and transport plan. In contrast, no transit agency document scored above 50\% nor includes accessibility indicators. Many documents also reveal inconsistencies between stated objectives, governance structures, and implementation pathways. This research highlights the growing consideration of accessibility in policy documents, but there remains a need for all organizations involved in the planning of land use and transportation systems to better define accessibility indicators.},
  keywords = {Accessibility,Land use,Lesen,Paradigm shift,Planning,Policy,Transport}
}

@article{cuiMeasuringAddedEffectiveness2019,
  title = {Measuring the {{Added Effectiveness}} of {{Using Detailed Spatial}} and {{Temporal Data}} in {{Generating Accessibility Measures}}},
  author = {Cui, Boer and Grisé, Emily and Stewart, Anson and El-Geneidy, Ahmed},
  date = {2019-07-19},
  journaltitle = {Findings},
  shortjournal = {Findings},
  publisher = {Findings Press},
  doi = {10.32866/9736},
  url = {https://findingspress.org/article/9736-measuring-the-added-effectiveness-of-using-detailed-spatial-and-temporal-data-in-generating-accessibility-measures},
  urldate = {2026-02-22},
  abstract = {It is hypothesized that spatially disaggregated and temporally variable data will lead to more accurate determinations of accessibility. This paper examines whether such measures are more effective in predicting public transport mode share and commute duration in Montreal, Canada through regression models. While results show that the model fit to predict mode share is better when accessibility is generated using detailed spatial and temporal data, the improvement is minimal. In predicting commute duration, no improvements are observed. Furthermore, the change in resulting values of accessibility between measures is observable and varies depending on the configuration and frequency of transport supply.},
  langid = {english},
  keywords = {Bibliography TAM,Gelesen}
}

@article{cuiPrimalDualAccess2020,
  title = {Primal and {{Dual Access}}},
  author = {Cui, Mengying and Levinson, David},
  date = {2020},
  journaltitle = {Geographical Analysis},
  volume = {52},
  number = {3},
  pages = {452--474},
  issn = {1538-4632},
  doi = {10.1111/gean.12220},
  url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/gean.12220},
  urldate = {2026-07-06},
  abstract = {Accessibility, measuring the ease of reaching potential destinations, is increasingly being considered as an effective indicator to evaluate the performance of transport and land use interactions. Primal accessibility, a generalization of the first accessibility formulation proposed by Hansen, has been widely used in many studies and demonstrated to be a reliable tool for project, program, and policy evaluation. The dual of accessibility, measuring the time required to reach a given number of opportunities, is less often considered but can be used for optimization in location covering-type problems. This article, hence, clarifies the definitions of primal and dual access, and applies both measures to the Minneapolis—St. Paul metropolitan area for auto and transit to demonstrate their practicality as a metropolitan-level measurement. We explore the correlations and differences between the primal and dual access to better understand the relative strengths of the measures. It is found that, as with primal accessibility, dual accessibility is an efficient approach to evaluate accessibility, which is straightforward to calculate and to explain to policy-makers and the public.},
  langid = {english}
}

@article{daiRacialEthnicSocioeconomic2011,
  title = {Racial/Ethnic and Socioeconomic Disparities in Urban Green Space Accessibility: {{Where}} to Intervene?},
  shorttitle = {Racial/Ethnic and Socioeconomic Disparities in Urban Green Space Accessibility},
  author = {Dai, Dajun},
  date = {2011-09-30},
  journaltitle = {Landscape and Urban Planning},
  shortjournal = {Landscape and Urban Planning},
  volume = {102},
  number = {4},
  pages = {234--244},
  issn = {0169-2046},
  doi = {10.1016/j.landurbplan.2011.05.002},
  url = {https://www.sciencedirect.com/science/article/pii/S0169204611001952},
  urldate = {2026-06-30},
  abstract = {Access to green spaces is important to physical activities and public health, yet one concern remains as to whether the disparities in green space access exist. This study aimed to (1) introduce an approach to quantify potential spatial accessibility to green spaces in a Geographic Information Systems (GIS) environment; and (2) evaluate the racial/ethnic and socioeconomic disparities in green space access. Urban green spaces (n=890) in metropolitan Atlanta, Georgia were collected from the Atlanta Regional Commission. A Gaussian-based two-step floating catchment area method was adapted to assess the spatial accessibility to green spaces at the census tract level. The Ordinary Least Squares (OLS) model and the spatial lag model were used to evaluate the racial/ethnic and socioeconomic disparities. Results suggest that the spatial accessibility to green spaces in Atlanta was not evenly distributed. Both models show that neighborhoods with a higher concentration of African Americans had significantly poorer access to green spaces (P{$<$}0.05). Asian population had significantly poor access in the OLS model but not in the spatial lag model. Poor access was present in socioeconomically disadvantaged areas as well. Findings can be used for the city and regional planners to target the specific areas for green space development in order to elucidate the disparities.},
  keywords = {Atlanta,Gaussian based 2-step floating catchment area method,Geographic Information Systems,Green space,Network analysis,Spatial access}
}


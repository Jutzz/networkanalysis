  title = {A {{New Method}} for {{Measuring Food-Aid Accessibility Considering Sustainability Constraints}}},
  booktitle = {2024 {{IEEE Conference}} on {{Technologies}} for {{Sustainability}} ({{SusTech}})},
  author = {Mahmoudi, Monirehalsadat and Shirzad, Khadijeh and Song, Ying},
  date = {2024-04},
  pages = {26--33},
  issn = {2640-6810},
  doi = {10.1109/SusTech60925.2024.10553431},
  url = {https://ieeexplore.ieee.org/abstract/document/10553431},
  urldate = {2026-06-30},
  abstract = {In this paper, we introduce the concept of resource-constrained accessibility and propose a new measurement, called space-time-resource hyper prism, to measure the access to food banks across service areas considering economic and environmental barriers such as monetary and CO emission budgets. We implement our method via dynamic programming and use the transportation network of the state of Michigan as a study case to demonstrate the methods and results. The scenario analysis results prove that our methods can effectively address various mobility constraints and support decision-making on sustainable resource allocations and management.},
